# RedBuddy Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Configuration (Choose ONE method)
# =============================================================================

# Option 1: Anthropic API (Recommended for production/open source)
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Change the model (default: claude-sonnet-4-20250514)
# Available models: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-5-haiku-20241022
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Option 2: Claude CLI (For personal use)
# If ANTHROPIC_API_KEY is not set, the tool will use Claude Code CLI
# Make sure Claude Code is installed: npm install -g @anthropic-ai/claude-code
# No configuration needed - just leave ANTHROPIC_API_KEY empty or commented out

# =============================================================================
# Optional: Reddit OAuth (not required for basic functionality)
# =============================================================================
# Get from https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback

# =============================================================================
# Custom Prompts (Optional)
# =============================================================================
# Override default prompts with your own optimized versions
# See /prompts/README.md for variable placeholders and examples

# REDBUDDY_PROMPT_SUGGEST=Your custom suggest prompt here
# REDBUDDY_PROMPT_VALIDATE=Your custom validation prompt here
# REDBUDDY_PROMPT_SHIELD=Your custom shield prompt here
# REDBUDDY_PROMPT_ANALYZE=Your custom analysis prompt here
# REDBUDDY_PROMPT_REFINE=Your custom refine prompt here

# =============================================================================
# Shield Configuration (Optional)
# =============================================================================
# Customize shield scoring weights (0-100, higher = more strict)

# SHIELD_WEIGHT_AI_TONE=20
# SHIELD_WEIGHT_SELF_PROMO=25
# SHIELD_WEIGHT_LOW_EFFORT=15
# SHIELD_WEIGHT_SPAM_PATTERN=30

# =============================================================================
# Notes
# =============================================================================
# - API mode: More reliable, proper rate limits, clear billing per token
# - CLI mode: Uses your Claude Code subscription, good for personal development
# - The tool automatically detects which mode to use based on API key presence
# - Custom prompts: Create files in /prompts/ or set environment variables
